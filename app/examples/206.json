  "steps": [
    {
      "id": "s1",
      "caption": "The key insight is that reversing a list just means pointing each node back at the node before it.",
      "elements": [
        {
          "type": "list",
          "id": "head",
          "x": 80,
          "y": 0,
          "variant": "linked",
          "label": "head",
          "items": [
            "1",
            "2",
            "3"
          ]
        }
      ]
    },
    {
      "id": "s2",
      "caption": "So I walk the list with previous and current pointers, saving next before I redirect current.next.",
      "elements": [
        {
          "type": "list",
          "id": "head",
          "x": 80,
          "y": 0,
          "variant": "linked",
          "label": "head",
          "items": [
            "1",
            "2",
            "3"
          ]
        },
        {
          "type": "pointer",
          "id": "prev",
          "x": 0,
