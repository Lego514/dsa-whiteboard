            "index": 0,
            "none": true
          }
        },
        {
          "type": "pointer",
          "id": "curr",
          "x": 0,
          "y": 0,
          "name": "curr",
          "attach": {
            "id": "head",
            "index": 0
          }
        }
      ]
    },
    {
