  "steps": [
    {
      "id": "s1",
      "caption": "The key insight is that each island is a connected group of land, so I count how many times I start a new search.",
      "elements": [
        {
          "type": "table",
          "id": "grid",
          "x": 0,
          "y": 0,
          "variant": "grid",
          "label": "grid",
          "rows": [
            [
              "1",
              "1",
              "0",
              "0"
            ],
            [
              "1",
              "0",
              "0",
              "1"
            ],
            [
              "0",
              "0",
              "1",
              "1"
            ]
          ]
        }
      ]
    },
    {
      "id": "s2",
      "caption": "So I scan the grid and, for every unvisited \"1\", run DFS or BFS to sink the whole island and add one to the count.",
