{
  "name": "dsa-whiteboard",
  "version": "0.1.5",
  "description": "A whiteboard for data structures and algorithms: arrays, pointers, trees, graphs, heaps, Union-Find, tries, bits, DP tables, intervals, recursion trees, step-by-step playback, and line-by-line code tracing. A React component and a standalone web app.",
  "license": "MIT",
  "author": "Lego514",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lego514/dsa-whiteboard.git"
  },
  "homepage": "https://lego514.github.io/dsa-whiteboard/",
  "keywords": [
    "whiteboard",
    "data-structures",
    "algorithms",
    "leetcode",
    "visualization",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/types/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./board.css": "./dist/board.css",
    "./base.css": "./dist/base.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:app",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/copy-css.mjs",
    "build:app": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build --mode e2e && playwright test",
    "media": "vite build --mode e2e && playwright test -c playwright.media.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gifenc": "1.0.3",
    "globals": "^17.12.0",
    "pngjs": "7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.149.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  }
}
